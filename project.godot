[input_devices]

pointing/android/enable_long_press_as_right_click=true

[internationalization]

locale/translation_remaps={}
locale/translations=PackedStringArray("res://ui_resources/translations/de.de.translation", "res://ui_resources/translations/es.es.translation", "res://ui_resources/translations/fr.fr.translation", "res://ui_resources/translations/ja.ja.translation")

[network]

limits/tcp/connect_timeout_seconds=15

[physics]

common/physics_ticks_per_second=1
common/max_physics_steps_per_frame=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
driver/threads/thread_model=0
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=1
environment/defaults/default_clear_color=Color(0.17, 0.17, 0.17, 1)
