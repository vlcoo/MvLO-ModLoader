msgstr "インストール場所"

msgid "Choose folder..."
msgstr "フォルダを選択..."

msgid "Extra args for {extension}"
msgstr "{extension} の追加引数"

msgid "Troubleshooting"
msgstr "トラブルシューティング"

msgid "Refresh DB"
msgstr "DBを更新"

msgid "Uninstall all mods"
msgstr "すべてのMODをアンインストールする"

msgid "Show logs"
msgstr "ログを表示"

msgid "Fix vanilla"
msgstr "バニラを修正"

