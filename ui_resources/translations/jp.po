msgid ""
"A simple way to keep your mods organized and up to date.\r\n"
"\r\n"
"[color=#ffffff8b]by vlco_o - aka vic[/color]"
msgstr ""
"MODを整理して最新の状態に保つための簡単な方法。\n"
"\n"
"[color=#ffffff8b]vlco_o - 別名vic[/color]"

msgid "by {name}"
msgstr "{name}より"

msgid "Use list view for mod gallery"
msgstr "MODギャラリーのリスト表示を使用する"

msgid "Show all platforms"
msgstr "すべてのプラットフォームを表示"

msgid "Auto subscribe to updates"
msgstr "更新情報を自動購読する"

msgid "Theme colour"
msgstr "テーマカラー"

msgid "Open last viewed tab on restart"
msgstr "再起動時に最後に表示したタブを開く"

msgid "Discord Game Activity (auto)"
msgstr "Discord ゲームアクティビティ (自動)"

msgid "Hide window when launching a mod"
msgstr "MOD起動時にウィンドウを非表示にする"

